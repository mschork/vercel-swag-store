# dependencies
node_modules

# build output
.next
# Next's SWC plugin cache, and what Vercel Workflow generates at build time
.swc
apps/store/app/.well-known/workflow
# written by the workflow integration tests (pnpm --filter store test:integration)
.workflow-data
.workflow-vitest
.turbo
dist
out

# env files: only the examples are committed
.env*
!.env.example

# tests
playwright-report
test-results
coverage

# generated schema snapshot; the types next to it are committed
packages/sanity/src/generated/schema.json

# tooling
.vercel
**/.sanity/*
# The Blueprint's stack and scope ids: no secrets, and deploys need them.
!/.sanity/blueprint.config.json
# Sanity Functions' local build output
apps/functions/**/.build
*.tsbuildinfo
next-env.d.ts

# os
.DS_Store

# local-only documents (unredacted references, notes)
working

# local agent skills (installed via skills.sh, not committed)
.claude/skills

# local issue tracker for agent skills (see docs/agents/issue-tracker.md)
.scratch

# The requirements document is third-party material and stays out of the repo.
the requirements
