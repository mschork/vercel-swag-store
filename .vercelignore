# What `vercel deploy` must not upload. The CLI is linked at the repo root, so
# deploys upload from here and read this file. Without it the CLI falls back to
# the `.gitignore` of the directory it ran in, and those directories have none.

# dependencies
node_modules

# build output and caches
.next
.turbo
dist
out
*.tsbuildinfo

# tests
playwright-report
test-results
coverage

# env files
.env*
!.env.example

# local-only documents and notes
working
.scratch
.sanity

# os
.DS_Store
