# Base URL of the Vercel Swag Store API, including the /api path
API_BASE_URL=https://vercel-swag-store-api.vercel.app/api
# Deployment Protection bypass token sent as x-vercel-protection-bypass (server only, never NEXT_PUBLIC_)
API_BYPASS_TOKEN=
# Sanity project id (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Sanity dataset (public)
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret the Sanity publish webhook signs its body with, checked by
# /api/revalidate/sanity (server only). Unset, the route refuses every call.
SANITY_REVALIDATE_SECRET=
# Shared secret for POST /api/revalidate/catalog, at least 32 characters (server only).
# Generate one with: openssl rand -hex 32. Unset, the route refuses every call.
CATALOG_REVALIDATE_SECRET=
# Canonical site URL for metadata and OG images, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E13 only (stretch), leave unset until then
# Sanity write token for the search-gap loop (server only)
# SANITY_API_WRITE_TOKEN=
# Secret protecting the demand-analysis endpoint (server only)
# DEMAND_ANALYSE_SECRET=
# Vercel AI Gateway key (server only)
# AI_GATEWAY_API_KEY=
