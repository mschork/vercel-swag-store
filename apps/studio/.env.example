# Sanity project id the Studio connects to
SANITY_STUDIO_PROJECT_ID=
# Sanity dataset
SANITY_STUDIO_DATASET=production
# Swag Store API base URL, used by the product picker (E08)
SANITY_STUDIO_API_BASE_URL=https://vercel-swag-store-api.vercel.app/api
# API bypass token for the product picker; the Studio itself is behind Sanity auth (E08)
SANITY_STUDIO_API_BYPASS_TOKEN=
