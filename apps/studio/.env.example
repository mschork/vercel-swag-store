# Sanity project id the Studio connects to
SANITY_STUDIO_PROJECT_ID=
# Sanity dataset
SANITY_STUDIO_DATASET=production
# The store the Presentation tool frames (E17). Defaults to the production store;
# set http://localhost:3000 to edit against a local `next start` or `next dev`.
SANITY_STUDIO_PREVIEW_ORIGIN=
